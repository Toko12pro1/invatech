# Copy this file to .env and fill in real values. .env is git-ignored.

# Safe for frontend use (public URL + RLS-constrained anon key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Optional Meta/Facebook Pixel ID. Leave empty until you create a pixel.
VITE_META_PIXEL_ID=

# Account/admin-level secrets — never prefix with VITE_, never import into src/.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
