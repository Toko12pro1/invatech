{
  "crons": [{ "path": "/api/keep-alive", "schedule": "15 2 * * *" }],
  "rewrites": [
    { "source": "/share/product/:id", "destination": "/api/share?type=product&id=:id" },
    { "source": "/share/store/:id", "destination": "/api/share?type=store&id=:id" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
